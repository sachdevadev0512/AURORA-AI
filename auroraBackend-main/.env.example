# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aurora
# MongoDB driver pool (shared across all modules/tenants on this process)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=30000
# Run Product.syncIndexes on every boot (default: only when index drift is detected)
SYNC_INDEXES_ON_STARTUP=false

# Environment
NODE_ENV=development
PORT=5000

# Amazon SP-API Credentials
AMAZON_CLIENT_ID=your_client_id
AMAZON_CLIENT_SECRET=your_client_secret
AMAZON_LWA_CLIENT_ID=your_lwa_client_id
AMAZON_LWA_CLIENT_SECRET=your_lwa_client_secret

# Order notifications (SP-API ORDER_CHANGE via SQS)
ORDER_NOTIFICATIONS_ENABLED=true
ORDER_NOTIFICATIONS_RESUBSCRIBE_ON_STARTUP=true
# Auto-create SQS queue + SP-API policy on startup (needs AWS credentials below)
ORDER_NOTIFICATIONS_AUTO_CREATE_SQS=false
ORDER_NOTIFICATIONS_AUTO_CREATE_DESTINATION=true
NOTIFICATION_DESTINATION_ID=
AWS_SQS_QUEUE_NAME=aurora-sp-api-order-notifications
AWS_SQS_QUEUE_ARN=
AWS_SQS_QUEUE_URL=
AWS_REGION=us-east-1
# NA | EU | FE — picks Amazon SP-API notification sender account for queue policy
AMAZON_SELLING_REGION=NA
# Optional override (defaults: NA=437568002678, EU=507733088537, FE=137659890050)
# AMAZON_NOTIFICATIONS_PRINCIPAL_AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ORDER_NOTIFICATIONS_SQS_POLL_ENABLED=true
AWS_SQS_POLL_INTERVAL_MS=5000
AWS_SQS_IDLE_POLL_INTERVAL_MS=30000
AWS_SQS_CONSUMER_CONCURRENCY=5
AWS_SQS_MAX_MESSAGES=10
AWS_SQS_VISIBILITY_TIMEOUT=60
AWS_SQS_MAX_RECEIVE_COUNT=5
AWS_SQS_DLQ_NAME=
AWS_SQS_DLQ_ARN=
AWS_SQS_DLQ_URL=
ORDER_DELTA_SYNC_LOOKBACK_MINUTES=30
# Dev only — never set true in production
SKIP_NOTIFICATION_SIGNATURE_VERIFY=false
NOTIFICATION_CERT_CACHE_TTL_MS=86400000
NOTIFICATION_MAX_TIMESTAMP_SKEW_MS=300000
WEBHOOK_URL=https://yourdomain.com/api/notifications/webhook/amazon

# Background inventory sync (FBA getInventorySummaries — persisted, auto-resumes on restart)
INVENTORY_SYNC_CATALOG_CONCURRENCY=5
INVENTORY_SYNC_BULK_SIZE=50
INVENTORY_SYNC_PROGRESS_EVERY=25
INVENTORY_SYNC_SKIP_UNCHANGED=true
# Worker threads for JSON-heavy product document assembly (0 = main thread only)
INVENTORY_SYNC_CPU_WORKERS=2
# Yield the event loop every N listing items during sync page processing
INVENTORY_SYNC_EVENT_LOOP_YIELD_EVERY=5
# Set true to fetch product images/titles from Catalog API (slower)
INVENTORY_SYNC_FETCH_CATALOG=false

ORDER_SYNC_CONCURRENCY=25
ORDER_SYNC_ITEM_CONCURRENCY=25
ORDER_SYNC_BULK_SIZE=50
ORDER_SYNC_PROGRESS_EVERY=100
# report = bulk flat-file reports (fast, default) | api = per-order SP-API calls (slow)
ORDER_SYNC_STRATEGY=report
ORDER_SYNC_REPORT_CHUNK_DAYS=30
ORDER_SYNC_REPORT_CHUNK_DELAY_MS=3000
ORDER_REPORT_POLL_INTERVAL_MS=5000
ORDER_REPORT_POLL_MAX_ATTEMPTS=120
ORDER_SYNC_FETCH_FINANCIAL_EVENTS=false
# CSV export caps (0 = unlimited)
ORDER_EXPORT_MAX_ORDER_IDS=0
ORDER_EXPORT_MAX_ROWS=0
PRODUCT_EXPORT_MAX_ROWS=0
SHIPMENT_EXPORT_MAX_ROWS=0
# Order analytics: limit "allTime" aggregation window to avoid full-history scans
ORDER_ANALYTICS_ALLTIME_MAX_DAYS=365
# Order sync jobs persist in MongoDB and auto-resume after Render/server restart
# Set true to fetch product images during sync (slower; skipped by default)
ORDER_SYNC_FETCH_CATALOG=false

# JWT Configuration — must be a strong random secret (min 32 chars; 64-byte hex recommended)
# Generate: node scripts/generate-jwt-secret.js
JWT_SECRET=
JWT_EXPIRE=7d

# Encrypt Amazon refresh tokens at rest in MongoDB
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Encrypt seller application Amazon credentials at rest (can match TOKEN_ENCRYPTION_KEY)
# Generate: openssl rand -base64 32
SELLER_APP_ENCRYPTION_KEY=

# Optional: Amazon Advertising API (if using ads feature)
AMAZON_ADVERTISING_CLIENT_ID=
AMAZON_ADVERTISING_CLIENT_SECRET=

# Background ads campaign sync (runs server-side, independent of frontend)
ADS_LIVE_SYNC_ENABLED=true
ADS_LIVE_SYNC_INTERVAL_MS=300000
ADS_LIVE_SYNC_RECONCILE_MS=120000

# Ads performance metrics (Amazon Reporting API v3)
ADS_METRICS_SYNC_DAYS=90
ADS_METRICS_SYNC_INTERVAL_MS=21600000
ADS_REPORT_POLL_INTERVAL_MS=3000
ADS_REPORT_POLL_MAX_ATTEMPTS=40
AMAZON_ADS_SCOPE=advertising::campaign_management

# API Rate Limiting (defaults are used when unset)
# Global API requests per IP per 15 minutes
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
# Auth requests per IP per 15 minutes
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
# Login attempts per IP per 15 minutes
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
# OAuth callback hits per IP per 10 minutes
RATE_LIMIT_OAUTH_WINDOW_MS=600000
RATE_LIMIT_OAUTH_MAX=50
# Expensive sync action calls per IP per 10 minutes
RATE_LIMIT_SYNC_WINDOW_MS=600000
RATE_LIMIT_SYNC_MAX=25
# mongo = shared MongoDB store (default, multi-instance safe) | memory = per-process only
RATE_LIMIT_STORE=mongo

# Auth middleware user cache TTL (ms). Reduces DB round-trips on every protected request.
AUTH_USER_CACHE_TTL_MS=120000

# Sync job lock lease (ms) — renewed by heartbeat; stale locks can be taken over with generation fencing
SYNC_JOB_LOCK_LEASE_MS=120000

# SP-API client-side pacing + retry (ms between calls per label; retries on 429/503/quota)
SP_API_MIN_INTERVAL_MS=200

# Short TTL in-memory cache for read-heavy endpoints (0 = disabled)
READ_RESPONSE_CACHE_TTL_MS=30000

# Socket.IO cross-instance adapter: mongo (default, Atlas replica set) | memory = single process only
SOCKET_IO_ADAPTER=mongo
# SOCKET_IO_ADAPTER_COLLECTION=socketio_adapter_events
