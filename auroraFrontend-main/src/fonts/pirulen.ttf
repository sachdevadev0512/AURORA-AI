<!-- Lightbox Modal -->
<div class="ff-lightbox" id="ffLightbox" onclick="ffLB.close()">
    <div class="ff-lightbox-close" onclick="ffLB.close()">&times;</div>
    <div class="ff-lightbox-prev ff-lightbox-nav" onclick="event.stopPropagation();ffLB.prev()">&#8249;</div>
    <img id="ffLBImg" src="" alt="" onclick="event.stopPropagation()">
    <div class="ff-lightbox-next ff-lightbox-nav" onclick="event.stopPropagation();ffLB.next()">&#8250;</div>
    <div class="ff-lightbox-counter" id="ffLBCounter"></div>
</div>
<script>
var ffLB = {
    imgs: [], idx: 0,
    open: function(imgs, idx) {
        this.imgs = imgs; this.idx = idx || 0;
        this.show();
        document.getElementById('ffLightbox').classList.add('active');
        document.body.style.overflow = 'hidden';
    },
    close: function() {
        document.getElementById('ffLightbox').classList.remove('active');
        document.body.style.overflow = '';
    },
    show: function() {
        var img = document.getElementById('ffLBImg');
        var counter = document.getElementById('ffLBCounter');
        img.src = this.imgs[this.idx];
        counter.textContent = (this.idx + 1) + ' / ' + this.imgs.length;
    },
    next: function() { this.idx = (this.idx + 1) % this.imgs.length; this.show(); },
    prev: function() { this.idx = (this.idx - 1 + this.imgs.length) % this.imgs.length; this.show(); }
};
document.addEventListener('keydown', function(e) {
    if (!document.getElementById('ffLightbox').classList.contains('active')) return;
    if (e.key === 'Escape') ffLB.close();
    if (e.key === 'ArrowRight') ffLB.next();
    if (e.key === 'ArrowLeft') ffLB.prev();
});
// Close tools dropdown on click outside
document.addEventListener('click', function(e) {
    var menus = document.querySelectorAll('.nav-dropdown-menu');
    for (var i = 0; i < menus.length; i++) {
        if (!menus[i].parentNode.contains(e.target)) menus[i].style.display = 'none';
    }
});
</script>

